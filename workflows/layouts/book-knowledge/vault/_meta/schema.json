{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralph-flow.local/schemas/book-knowledge-page.json",
  "title": "Book knowledge page frontmatter",
  "type": "object",
  "required": ["id", "title", "category", "summary", "aliases", "tags", "sources", "provenance", "lifecycle", "operational_status", "owners", "relations", "created", "updated"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "category": {"enum": ["book", "person", "author", "entity", "concept", "argument", "theme", "character", "setting", "practice", "skill", "reading_note", "journal", "reference", "synthesis"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 400},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "uri", "revision", "locator"], "properties": {"source_id": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "provenance": {"type": "object", "required": ["extracted", "inferred", "ambiguous"], "properties": {"extracted": {"type": "integer", "minimum": 0}, "inferred": {"type": "integer", "minimum": 0}, "ambiguous": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "lifecycle": {"enum": ["draft", "reviewed", "verified", "disputed", "archived"]},
    "operational_status": {"type": "object", "required": ["state", "replacement"], "properties": {"state": {"enum": ["active", "deprecated", "sunset"]}, "replacement": {"type": ["string", "null"]}}, "additionalProperties": true},
    "owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relations": {"type": "object"},
    "pending_relations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "publication_year": {"type": "integer"},
    "editions": {"type": "array"},
    "reading_status": {"enum": ["unread", "reading", "read", "paused", "abandoned", "rereading"]},
    "attributed_to": {}, "thesis": {}, "premises": {}, "objections": {},
    "book": {}, "reading_date": {"type": "string", "format": "date"}, "progress": {}, "reaction": {},
    "appears_in": {}, "role": {}, "steps": {}, "conditions": {}, "limitations": {}
  },
  "additionalProperties": true
}
